# === API Keys ===
# Get Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
# GOOGLE_API_KEY=your_gemini_key_here  (alternative env var name)

# === Model Selection ===
# Live API models: gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-preview-12-2025, gemini-2.0-flash-live-001
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# === Audio ===
AUDIO_SAMPLE_RATE=16000

# === Server ===
WS_HOST=0.0.0.0
WS_PORT=8765

# === Logging ===
LOG_DIR=logs
